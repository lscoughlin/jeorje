## Syntax file for Dart. Written for Jeorje.
##
syntax "Dart" "\.dart$"
comment "//"

color green "\<(int|double|num|bool|String|void|var|dynamic|List|Map|Set|Future|Stream|Object)\>"
color red "\<(if|else|for|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|rethrow|await|async|yield|on)\>"
color cyan "\<(abstract|class|extends|implements|with|mixin|enum|import|export|library|part|show|hide|as|is|new|const|final|late|static|factory|get|set|typedef|required|override|extension|this|super)\>"
color yellow "\<(true|false|null)\>"
color red ""(\\.|[^"])*"" "'(\\.|[^'])*'"
color yellow "\b[0-9]+(\.[0-9]+)?\b" "\b0x[0-9a-fA-F]+\b"
color brightblue "///.*"
color blue "//.*"
color blue start="/\*" end="\*/"
